{
  "name": "pokertd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pokertd/client --filter @pokertd/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "odds": "tsx packages/sim/src/cli/odds.ts",
    "balance": "tsx tools/balance.ts",
    "loadtest": "tsx tools/loadtest.ts",
    "e2e": "pnpm --filter @pokertd/client build && node tools/e2e.mjs",
    "start": "pnpm --filter @pokertd/client build && STATIC_DIR=apps/client/dist pnpm --filter @pokertd/server start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "playwright": "1.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
