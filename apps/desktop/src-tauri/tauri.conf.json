{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poker TD",
  "version": "0.2.0",
  "identifier": "com.pokertd.game",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @pokertd/client dev",
    "beforeBuildCommand": "pnpm --filter @pokertd/client build"
  },
  "app": {
    "windows": [
      {
        "title": "Poker TD",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "StrategyGame",
    "shortDescription": "Poker-hand tower defense, solo or with friends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
